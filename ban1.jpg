window._wpemojiSettings = {"baseUrl":"https:\/\/s.w.org\/images\/core\/emoji\/15.0.3\/72x72\/","ext":".png","svgUrl":"https:\/\/s.w.org\/images\/core\/emoji\/15.0.3\/svg\/","svgExt":".svg","source":{"wpemoji":"https:\/\/slbsolution.com\/wp-includes\/js\/wp-emoji.js?ver=6.6.4","twemoji":"https:\/\/slbsolution.com\/wp-includes\/js\/twemoji.js?ver=6.6.4"}};
/**
